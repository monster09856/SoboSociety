# Geliştirme/üretim veritabanı. Üretimde güçlü, rotasyona tabi bir şifre
# kullanılmalı — buradaki "sobo:sobo" yalnızca yerel geliştirme içindir.
DATABASE_URL=postgresql+asyncpg://sobo:sobo@localhost:5433/sobo

# Test veritabanı — pytest bu veritabanını drop_all/TRUNCATE eder.
# Ad mutlaka "test" içermeli (bkz. tests/conftest.py içindeki güvenlik kontrolü).
TEST_DATABASE_URL=postgresql+asyncpg://sobo:sobo@localhost:5433/sobo_test
